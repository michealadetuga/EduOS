# ---- EduOS environment (copy to .env in the repo root; never commit .env) ----

# development | test | production
NODE_ENV=development
PORT=4000
# Public URL used in emails (verification / reset / invite links). Required in production.
APP_URL=http://localhost:5173

# SQLite database file (created automatically). Use ":memory:" for tests.
DATABASE_URL=./data/eduos.db

# Secret used to hash session tokens and sign one-time tokens.
# MUST be >= 32 random characters in production:  openssl rand -hex 32
AUTH_SECRET=
SESSION_TTL_HOURS=168

# Email delivery. "outbox" writes .eml/.json files to ./outbox (dev). "resend" uses Resend's HTTP API.
EMAIL_PROVIDER=outbox
EMAIL_API_KEY=
EMAIL_FROM="EduOS <no-reply@yourschool.ng>"

# File storage. "local" stores under STORAGE_DIR/school/{schoolId}/... (tenant-scoped paths).
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
